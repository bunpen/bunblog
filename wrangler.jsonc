{
	"compatibility_date": "2026-05-04",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "bunblog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
    {
      "binding": "BLOG_KV",
      "id": "3",
      "preview_id": "3"
    }
  ]
}